---
// Concept scene — one idea, with an optional big stat and/or a terminal-style reveal.
// Used for "What is a Copilot Credit?" (stat) and the /cost command (terminal).
interface Props { scene: any; index: number; }
const { scene, index } = Astro.props;
function fmt(s = '') {
  return s.replace(/\*([^*]+)\*/g, '<span class="uline">$1</span>')
          .replace(/_([^_]+)_/g, '<span class="accent">$1</span>')
          .replace(/`([^`]+)`/g, '<code>$1</code>');
}
---
<section class="screen concept-scene" data-scene-index={index} data-notes={scene.notes} id={scene.id}>
  <div class="wrap">
    <div class="s-head">
      {scene.eyebrow && <span class="eyebrow">{scene.eyebrow}</span>}
      {scene.kicker && <div class="kicker">{scene.kicker}</div>}
      <h1 class="scene-h1" set:html={fmt(scene.headline)} />
    </div>
    <div class="s-body">
    <div class="concept-grid">
      <div class="ctext">
        {scene.body && <p class="lead" set:html={fmt(scene.body)} />}
        {scene.tip && <div class="ctip"><span class="ctip-mark">✺</span><span set:html={fmt(scene.tip)} /></div>}
      </div>
      <div class="cvisual">
        {scene.stat && (
          <div class="statcard">
            <div class="bigstat" data-countup={scene.stat.value}>{scene.stat.value}</div>
            <div class="statlab">{scene.stat.label}</div>
          </div>
        )}
        {scene.terminal && (
          <div class="terminal" data-terminal>
            <div class="tbar"><span></span><span></span><span></span></div>
            <div class="tbody">
              <div class="tprompt"><span class="caret">›</span> {scene.terminal.prompt}</div>
              <div class="treply" data-reply><span class="gauge">◷</span> {scene.terminal.reply}</div>
            </div>
          </div>
        )}
      </div>
    </div>
    </div>
  </div>
</section>

<style>
  .concept-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(24px,4vw,56px); align-items: start; padding-top: clamp(8px,3vh,40px); }
  @media (max-width: 820px) { .concept-grid { grid-template-columns: 1fr; } }
  .concept-scene code { font-family: "Cascadia Code", "Consolas", monospace; background: var(--navy-soft); color: var(--navy); padding: 1px 7px; border-radius: 6px; font-size: .92em; }
  .ctip { display: flex; align-items: flex-start; gap: 9px; margin-top: 20px; font-family: var(--hand); font-weight: 700; color: var(--red); font-size: clamp(17px,2vw,24px); line-height: 1.3; }
  .ctip-mark { font-family: var(--ui); font-size: .8em; transform: translateY(2px); }
  .ctip .uline { box-shadow: inset 0 -.42em 0 var(--red-soft); color: var(--red); }
  .statcard { background: var(--card); border: 1px solid var(--hair); border-radius: 18px; padding: 36px 30px; box-shadow: var(--shadow); text-align: center; border-top: 6px solid var(--brass); }
  .bigstat { font-family: var(--ui-semi); font-size: clamp(54px,9vw,104px); color: var(--brass); line-height: 1; letter-spacing: -2px; }
  .statlab { font-size: clamp(14px,1.6vw,18px); color: var(--inklite); margin-top: 10px; font-weight: 600; }
  .terminal { background: #1b1916; border: 1px solid var(--hair); border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; }
  .tbar { background: #2a2622; padding: 10px 14px; display: flex; gap: 7px; }
  .tbar span { width: 11px; height: 11px; border-radius: 50%; background: #4a443c; }
  .tbar span:first-child { background: #cf6a5a; } .tbar span:nth-child(2) { background: #cda86a; }
  .tbody { padding: 22px 22px 26px; font-family: "Cascadia Code", "Consolas", monospace; font-size: clamp(13px,1.5vw,16px); }
  .tprompt { color: #efe9dc; }
  .tprompt .caret { color: #cda86a; }
  .treply { color: #9db6dc; margin-top: 16px; opacity: 0; transform: translateY(6px); transition: all .4s ease; }
  .treply.show { opacity: 1; transform: none; }
  .treply .gauge { color: #cda86a; }
  @media (prefers-reduced-motion: reduce) { .treply { opacity: 1; transform: none; } }
</style>

<script>
  function initConcept() {
    document.querySelectorAll<HTMLElement>('.concept-scene').forEach((scene) => {
      if ((scene as any)._cInit) return;
      (scene as any)._cInit = true;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const run = () => {
        // terminal reply reveal
        const reply = scene.querySelector('[data-reply]');
        if (reply) { reply.classList.remove('show'); setTimeout(() => reply.classList.add('show'), reduce ? 0 : 650); }
        // stat count-up (numbers only, keeps prefix/suffix like $ and ¢)
        const stat = scene.querySelector<HTMLElement>('.bigstat');
        if (stat && !reduce) {
          const target = stat.dataset.countup || stat.textContent || '';
          const num = parseFloat(target.replace(/[^0-9.]/g, ''));
          if (!isNaN(num)) {
            const pre = target.slice(0, target.search(/[0-9]/));
            const suf = target.slice(target.search(/[0-9]/) + String(num).length);
            const t0 = performance.now(), dur = 700;
            const tick = (now: number) => {
              const p = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - p, 3);
              const v = num * e;
              stat.textContent = pre + (num < 1 ? v.toFixed(2) : Math.round(v)) + suf;
              if (p < 1) requestAnimationFrame(tick); else stat.textContent = target;
            };
            requestAnimationFrame(tick);
          }
        }
      };

      if (scene.classList.contains('active')) run();
      new MutationObserver(() => { if (scene.classList.contains('active')) run(); })
        .observe(scene, { attributes: true, attributeFilter: ['class'] });
    });
  }
  initConcept();
  document.addEventListener('astro:page-load', initConcept);
</script>
