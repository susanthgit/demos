---
// CostMeter scene — interactive explainer. Numbers come from a NAMED model
// (src/models/), serialized to the client so the scene can't inline pricing.
import { COWORK_COST_ILLUSTRATIVE } from '../../models/cowork-cost-illustrative';

interface Props { scene: any; index: number; }
const { scene, index } = Astro.props;

const MODELS: Record<string, any> = {
  'cowork-cost-illustrative': COWORK_COST_ILLUSTRATIVE,
};
const model = MODELS[scene.model] ?? COWORK_COST_ILLUSTRATIVE;

function fmt(s = '') {
  return s.replace(/\*([^*]+)\*/g, '<span class="uline">$1</span>')
          .replace(/_([^_]+)_/g, '<span class="accent">$1</span>');
}
---
<section
  class="screen cost-scene"
  data-scene-index={index}
  data-notes={scene.notes}
  id={scene.id}
  data-model={JSON.stringify(model)}
  data-disclaimer={scene.disclaimer}
>
  <div class="wrap">
    {scene.eyebrow && <div class="eyebrow">{scene.eyebrow}</div>}
    {scene.kicker && <div class="kicker">{scene.kicker}</div>}
    <h1 class="scene-h1" set:html={fmt(scene.headline)} />

    <div class="cost-grid">
      <!-- controls -->
      <div class="panel">
        <h4>Shape it to their world →</h4>
        <p class="phint">Drag these in the room — the numbers move live.</p>
        {scene.inputs.map((inp: any) => (
          <div class="ctl">
            <div class="clab"><span>{inp.label}</span><b data-out={inp.id}>{inp.default}</b></div>
            <input type="range" data-input={inp.id} min={inp.min} max={inp.max} step={inp.step} value={inp.default} />
            {inp.hint && <div class="phint">{inp.hint}</div>}
          </div>
        ))}
        <div class="ctl">
          <div class="clab"><span>Compare against</span></div>
          <div class="seg" role="group" aria-label="Comparison baseline">
            <button data-base="flatSeat" aria-pressed="true">Flat seat for everyone</button>
            <button data-base="analystHours" aria-pressed="false">Analyst hours</button>
          </div>
        </div>
      </div>

      <!-- result -->
      <div class="result">
        <div class="headline">
          <div class="scribble">↙ their number</div>
          <div class="lab">this pilot, this month</div>
          <div class="big" data-out="bigNum">$0</div>
          <div class="sub" data-out="bigSub">usage-based — you only pay for the packs actually produced.</div>
        </div>
        <div class="chartcard">
          <div class="ctitle">Usage-based vs <span data-out="baseLabel">flat seats</span></div>
          <div class="csub">Illustrative — figures move with the sliders.</div>
          <div class="barrow">
            <div class="bname" data-out="rowBaseName">Flat seats</div>
            <div class="bartrack"><div class="barfill flat" data-bar="base"><b data-out="barBaseV">$0</b></div></div>
          </div>
          <div class="barrow">
            <div class="bname">Cowork usage</div>
            <div class="bartrack"><div class="barfill cw" data-bar="cw"><b data-out="barCwV">$0</b></div></div>
          </div>
        </div>
        <div class="statgrid">
          <div class="stat"><b data-out="sPacks">0</b><span>packs / month</span></div>
          <div class="stat"><b data-out="sDays">0</b><span>analyst-days saved*</span></div>
          <div class="stat"><b data-out="sSave">0%</b><span>vs baseline</span></div>
        </div>
        <div class="controls">
          <span class="cchip"><i></i>Admin sees spend live</span>
          <span class="cchip"><i></i>Set a cap per team</span>
          <span class="cchip"><i></i>Stays in your tenant</span>
        </div>
      </div>
    </div>

    <div class="ledger">
      <div class="disc"><b>{scene.disclaimer}</b> Use the customer's real licensing for any number that leaves the room. *Analyst-days saved is a planning estimate.</div>
      <span class="ledgchip" data-ledger>✓ source &amp; verify trail</span>
    </div>
  </div>
</section>

<style>
  .cost-grid { display: grid; grid-template-columns: .92fr 1.08fr; gap: clamp(20px,3vw,46px); align-items: start; margin-top: 14px; }
  @media (max-width: 880px) { .cost-grid { grid-template-columns: 1fr; } }
  .panel { background: var(--card); border: 1px solid var(--hair); border-radius: 16px; padding: 22px 24px; box-shadow: var(--shadow); }
  .panel h4 { font-family: var(--ui-semi); font-size: 13px; color: var(--inklite); text-transform: uppercase; letter-spacing: 1.8px; margin-bottom: 4px; }
  .phint { font-size: 12px; color: var(--inklite); margin-top: 3px; line-height: 1.4; }
  .ctl { margin: 16px 0; }
  .clab { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .clab span { font-weight: 600; font-size: 14.5px; }
  .clab b { font-family: var(--ui-semi); color: var(--navy); font-size: clamp(20px,2.4vw,26px); }
  input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 8px; border-radius: 999px; background: linear-gradient(90deg,var(--navy) var(--fill,40%),var(--navy-soft) var(--fill,40%)); outline: none; cursor: pointer; }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 26px; border-radius: 50%; background: var(--brass); border: 3px solid var(--card); box-shadow: 0 4px 12px -3px rgba(0,0,0,.5); cursor: grab; }
  input[type=range]::-moz-range-thumb { width: 26px; height: 26px; border-radius: 50%; background: var(--brass); border: 3px solid var(--card); cursor: grab; }
  .seg { display: inline-flex; background: var(--paper); border: 1px solid var(--hair); border-radius: 999px; padding: 3px; gap: 2px; margin-top: 4px; }
  .seg button { border: 0; background: transparent; color: var(--inklite); font-family: var(--ui); font-weight: 700; font-size: 12.5px; padding: 6px 13px; border-radius: 999px; cursor: pointer; transition: all .18s; }
  .seg button[aria-pressed="true"] { background: var(--navy); color: var(--paper); }
  .result { display: flex; flex-direction: column; gap: 16px; }
  .headline { background: var(--card); border: 1px solid var(--hair); border-left: 7px solid var(--green); border-radius: 14px; padding: 18px 22px; box-shadow: var(--shadow); position: relative; overflow: hidden; }
  .headline .lab { font-family: var(--hand); color: var(--brass); font-size: 24px; line-height: 1; }
  .headline .big { font-family: var(--ui-semi); font-size: clamp(34px,5vw,56px); color: var(--green); line-height: 1.05; margin: 2px 0; }
  .headline .sub { font-size: 14px; color: var(--inklite); line-height: 1.4; }
  .headline .scribble { position: absolute; right: 14px; top: 12px; font-family: var(--hand); color: var(--brass); font-size: 20px; transform: rotate(-7deg); display: none; }
  body[data-mode="presenter"] .headline .scribble { display: block; }
  .chartcard { background: var(--card); border: 1px solid var(--hair); border-radius: 14px; padding: 18px 20px 12px; box-shadow: var(--shadow); }
  .ctitle { font-family: var(--ui-semi); font-size: 14px; color: var(--ink); margin-bottom: 2px; }
  .csub { font-size: 11.5px; color: var(--inklite); margin-bottom: 10px; }
  .barrow { display: flex; align-items: center; gap: 12px; margin: 11px 0; }
  .bname { width: 118px; font-size: 12.5px; font-weight: 700; color: var(--inklite); text-align: right; flex: none; }
  .bartrack { flex: 1; height: 30px; background: var(--navy-soft); border-radius: 8px; overflow: hidden; position: relative; }
  .barfill { height: 100%; border-radius: 8px; width: 0; transition: width .9s cubic-bezier(.2,.7,.2,1); display: flex; align-items: center; justify-content: flex-end; padding-right: 10px; }
  .barfill.flat { background: repeating-linear-gradient(45deg,var(--inklite),var(--inklite) 7px,#7a756c 7px,#7a756c 14px); }
  .barfill.cw { background: linear-gradient(90deg,var(--navy),var(--brass)); }
  .barfill b { color: #fff; font-family: var(--ui-semi); font-size: 13px; white-space: nowrap; text-shadow: 0 1px 2px rgba(0,0,0,.3); }
  .statgrid { display: flex; gap: 12px; }
  .stat { flex: 1; background: var(--paper); border: 1px solid var(--hair); border-radius: 12px; padding: 13px; }
  .stat b { display: block; font-family: var(--ui-semi); font-size: clamp(22px,3vw,32px); color: var(--navy); line-height: 1; }
  .stat span { font-size: 11.5px; color: var(--inklite); font-weight: 600; }
  .controls { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .cchip { display: inline-flex; align-items: center; gap: 7px; background: var(--card); border: 1px solid var(--hair); border-radius: 999px; padding: 7px 13px; font-size: 12.5px; font-weight: 600; }
  .cchip i { width: 8px; height: 8px; border-radius: 50%; background: var(--navy); }
  .ledger { margin-top: 18px; display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; border-top: 1px dashed var(--hair); padding-top: 12px; }
  .ledger .disc { font-size: 11.5px; color: var(--inklite); line-height: 1.4; max-width: 64ch; }
  .ledger .disc b { color: var(--brass); }
  .ledgchip { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; color: var(--navy); background: var(--navy-soft); border-radius: 7px; padding: 5px 9px; cursor: help; white-space: nowrap; }
</style>

<script>
  // CostMeter client behaviour — bundled (zero CDN). One scene per page.
  function initCostMeter() {
    const root = document.querySelector('.cost-scene') as HTMLElement | null;
    if (!root) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const model = JSON.parse(root.dataset.model || '{}');
    const out = (k: string) => root.querySelector(`[data-out="${k}"]`) as HTMLElement | null;

    const vals: Record<string, number> = {};
    root.querySelectorAll<HTMLInputElement>('[data-input]').forEach((el) => {
      vals[el.dataset.input!] = +el.value;
      fillSlider(el);
    });
    let base: 'flatSeat' | 'analystHours' = 'flatSeat';

    function fillSlider(el: HTMLInputElement) {
      const min = +el.min, max = +el.max;
      el.style.setProperty('--fill', ((+el.value - min) / (max - min) * 100) + '%');
    }
    const money = (v: number) => '$' + Math.round(v).toLocaleString();
    const int = (v: number) => Math.round(v).toLocaleString();

    function animNum(el: HTMLElement | null, to: number, fmt: (n: number) => string) {
      if (!el) return;
      if (reduce) { el.textContent = fmt(to); return; }
      const from = parseFloat(el.dataset.v || '0'), t0 = performance.now(), dur = 480;
      function tick(now: number) {
        const p = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - p, 3), v = from + (to - from) * e;
        el!.textContent = fmt(v);
        if (p < 1) requestAnimationFrame(tick); else el!.dataset.v = String(to);
      }
      requestAnimationFrame(tick);
    }

    function recalc() {
      const users = vals['users'] ?? 0, packs = vals['packs'] ?? 0;
      const totalPacks = users * packs;
      const cwCost = totalPacks * model.packPrice;
      const flatCost = users * model.flatSeat;
      const analystCost = totalPacks * model.daysPerPack * model.analystDay;
      const baseCost = base === 'flatSeat' ? flatCost : analystCost;
      const daysSaved = totalPacks * model.daysPerPack;
      const savePct = baseCost > 0 ? Math.max(0, (1 - cwCost / baseCost) * 100) : 0;

      animNum(out('bigNum'), cwCost, money);
      animNum(out('sPacks'), totalPacks, int);
      animNum(out('sDays'), daysSaved, int);
      animNum(out('sSave'), savePct, (v) => Math.round(v) + '%');

      const max = Math.max(cwCost, baseCost, 1);
      (root!.querySelector('[data-bar="cw"]') as HTMLElement).style.width = (cwCost / max * 100) + '%';
      (root!.querySelector('[data-bar="base"]') as HTMLElement).style.width = (baseCost / max * 100) + '%';
      animNum(out('barCwV'), cwCost, money);
      animNum(out('barBaseV'), baseCost, money);

      const bn = out('rowBaseName'); if (bn) bn.textContent = base === 'flatSeat' ? 'Flat seats' : 'Analyst hours';
      const bl = out('baseLabel'); if (bl) bl.textContent = base === 'flatSeat' ? 'flat seats' : 'analyst hours';
      const sub = out('bigSub');
      if (sub) sub.textContent = base === 'flatSeat'
        ? 'usage-based — you only pay for the packs actually produced.'
        : `the same ${int(totalPacks)} packs by hand ≈ ${money(analystCost)} in analyst time.`;
    }

    root.querySelectorAll<HTMLInputElement>('[data-input]').forEach((el) => {
      el.addEventListener('input', () => { vals[el.dataset.input!] = +el.value; fillSlider(el);
        const o = out(el.dataset.input!); if (o) o.textContent = String(el.value); recalc(); });
    });
    root.querySelectorAll<HTMLButtonElement>('[data-base]').forEach((b) => {
      b.addEventListener('click', () => {
        root.querySelectorAll('[data-base]').forEach((x) => x.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', 'true');
        base = b.dataset.base as any; recalc();
      });
    });
    const ledger = root.querySelector('[data-ledger]');
    if (ledger) ledger.addEventListener('click', () => alert(
      'Truth ledger (every demo carries one):\n\n• Claim: usage-based billing, admin spend controls, in-tenant\n• Source: ' + (model.source || 'public Microsoft docs') +
      '\n• Figures: ILLUSTRATIVE placeholders, not pricing\n• Last verified: set on publish\n• Classification: PUBLIC — no customer/tenant data'));

    recalc();
  }
  initCostMeter();
  document.addEventListener('astro:page-load', initCostMeter);
</script>
