---
// Cover scene — the explainer opener.
interface Props { scene: any; index: number; }
const { scene, index } = Astro.props;

// *word* → brass underline · _word_ → navy italic accent
function fmt(s = '') {
  return s
    .replace(/\*([^*]+)\*/g, '<span class="uline">$1</span>')
    .replace(/_([^_]+)_/g, '<span class="accent">$1</span>');
}
---
<section class="screen cover-scene" data-scene-index={index} data-notes={scene.notes} id={scene.id}>
  <div class="wrap">
    <div class="cover-grid">
      <div>
        {scene.eyebrow && <span class="eyebrow">{scene.eyebrow}</span>}
        {scene.kicker && <div class="kicker">{scene.kicker}</div>}
        <h1 class="scene-h1" set:html={fmt(scene.headline)} />
        {scene.lead && <p class="lead">{scene.lead}</p>}
        {scene.signature && <div class="sig" style="margin-top:22px">{scene.signature}</div>}
      </div>
      <div class="cover-right">
        {scene.why && (
          <div class="why">
            <div class="lab">{scene.why.label}</div>
            <p set:html={fmt(scene.why.body)} />
          </div>
        )}
        {scene.chips && scene.chips.length > 0 && (
          <div class="filefan">
            {scene.chips.map((c: any) => (
              <span class="fchip"><i style={`background:${c.color || 'var(--navy)'}`}></i>{c.label}</span>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cover-grid { display: grid; grid-template-columns: 1.25fr .9fr; gap: clamp(24px,4vw,64px); align-items: center; }
  .cover-right { display: flex; flex-direction: column; gap: 18px; }
  .filefan { display: flex; flex-wrap: wrap; gap: 9px; max-width: 30ch; }
  .fchip { display: flex; align-items: center; gap: 8px; background: var(--card); border: 1px solid var(--hair); border-radius: 9px; padding: 8px 12px; font-size: 13px; font-weight: 600; box-shadow: 0 6px 16px -12px rgba(0,0,0,.4); }
  .fchip i { width: 9px; height: 9px; border-radius: 3px; display: inline-block; }
  @media (max-width: 860px) { .cover-grid { grid-template-columns: 1fr; } }
</style>
