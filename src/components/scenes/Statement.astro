---
// Statement scene — PowerPoint-style: a big TITLE pinned to the top of the page, then the
// teaching message (and an optional hand-drawn diagram) below it. Red-ink kicker for attention.
// aside 'meter' = the universal pay-for-what-you-use metaphor, animated on land.
interface Props { scene: any; index: number; }
const { scene, index } = Astro.props;
function fmt(s = '') {
  return s.replace(/\*([^*]+)\*/g, '<span class="uline">$1</span>')
          .replace(/_([^_]+)_/g, '<span class="accent">$1</span>');
}
const hasAside = !!scene.aside;
---
<section class={`screen statement-scene ${hasAside ? 'has-aside' : ''}`} data-scene-index={index} data-notes={scene.notes} id={scene.id}>
  <div class="wrap">
    <header class="st-head">
      {scene.eyebrow && <span class="eyebrow">{scene.eyebrow}</span>}
      {scene.title && <h2 class="st-title">{scene.title}</h2>}
      {scene.title && <span class="st-rule"></span>}
    </header>

    <div class="st-cols">
      <div class="st-left">
        {scene.kicker && <div class="kicker">{scene.kicker}</div>}
        <h1 class="st-text" set:html={fmt(scene.text)} />
        {scene.sub && <p class="st-sub">{scene.sub}</p>}
      </div>

      {scene.aside === 'meter' && (
        <div class="st-aside">
          <div class="meter">
            <svg viewBox="0 0 240 168" role="img" aria-label="A meter — you pay for what you use">
              <path class="m-arc" d="M28 140 A92 92 0 0 1 212 140" fill="none" stroke-width="3" stroke-linecap="round" />
              <path class="m-used" d="M28 140 A92 92 0 0 1 212 140" fill="none" stroke-width="7" stroke-linecap="round" />
              <g class="m-ticks">
                <line x1="28" y1="140" x2="40" y2="140" /><line x1="120" y1="48" x2="120" y2="62" /><line x1="212" y1="140" x2="200" y2="140" />
              </g>
              <g class="m-needle"><line x1="120" y1="140" x2="120" y2="66" stroke-width="4" stroke-linecap="round" /><circle cx="120" cy="140" r="9" /></g>
              <text class="m-cap-l" x="26" y="158">low</text>
              <text class="m-cap-r" x="214" y="158" text-anchor="end">high</text>
            </svg>
            <div class="m-foot"><span class="coin">$</span><span class="coin">$</span><span class="coin big">$</span></div>
          </div>
          {scene.asideCaption && <div class="st-acap">{scene.asideCaption}</div>}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .statement-scene .wrap { display: flex; flex-direction: column; height: 100%; }
  .st-head { flex: none; }
  .st-title { font-family: var(--ui-semi); font-weight: 700; color: var(--ink); line-height: 1.02;
    font-size: clamp(30px,5vw,60px); letter-spacing: -.5px; margin-top: 4px; }
  .st-rule { display: block; width: 64px; height: 5px; border-radius: 999px; background: var(--brass); margin-top: 14px; opacity: .92; }

  .st-cols { flex: 1; display: grid; grid-template-columns: 1fr; gap: clamp(24px,4vw,56px); align-items: center; width: 100%; min-height: 0; }
  .statement-scene.has-aside .st-cols { grid-template-columns: 1.15fr .85fr; }
  @media (max-width: 820px) { .statement-scene.has-aside .st-cols { grid-template-columns: 1fr; } }

  .st-text { font-family: var(--ui-semi); font-weight: 700; line-height: 1.08; color: var(--ink);
    font-size: clamp(32px,5.6vw,68px); letter-spacing: -1px; max-width: 17ch; margin-top: 8px;
    opacity: 0; transform: translateY(14px); transition: opacity .55s ease, transform .55s cubic-bezier(.22,.61,.36,1); transition-delay: .15s; }
  .statement-scene.play .st-text { opacity: 1; transform: none; }
  .st-sub { margin-top: clamp(14px,2.2vw,24px); font-size: clamp(16px,1.9vw,23px); color: var(--inklite); line-height: 1.4; max-width: 40ch;
    opacity: 0; transition: opacity .5s ease; transition-delay: .45s; }
  .statement-scene.play .st-sub { opacity: 1; }

  /* hand-drawn meter */
  .st-aside { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .meter { width: min(360px, 80%); }
  .meter svg { width: 100%; height: auto; overflow: visible; }
  .m-arc { stroke: var(--hair); }
  .m-used { stroke: var(--red); stroke-dasharray: 289; stroke-dashoffset: 289; transition: stroke-dashoffset 1.1s cubic-bezier(.22,.61,.36,1); transition-delay: .35s; }
  .statement-scene.play .m-used { stroke-dashoffset: 96; }
  .m-ticks line { stroke: var(--inklite); stroke-width: 2.5; }
  .m-needle line { stroke: var(--navy); transform-origin: 120px 140px; transform: rotate(-72deg); transition: transform 1.1s cubic-bezier(.34,1.3,.5,1); transition-delay: .35s; }
  .statement-scene.play .m-needle line { transform: rotate(38deg); }
  .m-needle circle { fill: var(--navy); }
  .m-cap-l, .m-cap-r { font-family: var(--ui); font-weight: 700; fill: var(--inklite); font-size: 13px; }
  .m-foot { display: flex; justify-content: center; gap: 10px; margin-top: 6px; }
  .coin { font-family: var(--ui-semi); color: var(--brass); font-size: 20px; opacity: .5; }
  .coin.big { font-size: 30px; opacity: 1; }
  .st-acap { font-family: var(--hand); font-weight: 700; color: var(--red); font-size: clamp(17px,1.9vw,23px); text-align: center; line-height: 1.2; }

  @media (prefers-reduced-motion: reduce) {
    .st-text, .st-sub { opacity: 1; transform: none; transition: none; }
    .m-used { stroke-dashoffset: 96; transition: none; }
    .m-needle line { transform: rotate(38deg); transition: none; }
  }
</style>

<script>
  function initStatement() {
    document.querySelectorAll<HTMLElement>('.statement-scene').forEach((scene) => {
      if ((scene as any)._stInit) return;
      (scene as any)._stInit = true;
      let wasActive = scene.classList.contains('active');
      const play = () => { scene.classList.remove('play'); void scene.offsetWidth; scene.classList.add('play'); };
      if (wasActive) play();
      new MutationObserver(() => {
        const isActive = scene.classList.contains('active');
        if (isActive && !wasActive) play();
        wasActive = isActive;
      }).observe(scene, { attributes: true, attributeFilter: ['class'] });
    });
  }
  initStatement();
  document.addEventListener('astro:page-load', initStatement);
</script>
