---
// Tiers scene — Light / Medium / Heavy task sizes (cards stagger in on land).
interface Props { scene: any; index: number; }
const { scene, index } = Astro.props;
function fmt(s = '') {
  return s.replace(/\*([^*]+)\*/g, '<span class="uline">$1</span>')
          .replace(/_([^_]+)_/g, '<span class="accent">$1</span>');
}
---
<section class="screen tiers-scene" data-scene-index={index} data-notes={scene.notes} id={scene.id}>
  <div class="wrap">
    <div class="s-head">
      {scene.eyebrow && <span class="eyebrow">{scene.eyebrow}</span>}
      {scene.kicker && <div class="kicker">{scene.kicker}</div>}
      <h1 class="scene-h1" set:html={fmt(scene.headline)} />
    </div>

    <div class="s-body">
    <div class="tiers">
      {scene.tiers.map((t: any, i: number) => (
        <div class="tier" style={`--c:${t.color}; --i:${i}`}>
          <div class="tname">{t.name}</div>
          <ul class="traits">
            {t.traits.map((tr: string) => <li>{tr}</li>)}
          </ul>
          <div class="ex">
            <div class="exlab">example</div>
            <p>“{t.example}”</p>
          </div>
          <div class="tfoot">
            <div class="cr"><b>{t.credits}</b><span>credits</span></div>
            {t.dollars && <div class="dl">≈ {t.dollars}</div>}
          </div>
        </div>
      ))}
    </div>
    {scene.note && <div class="tnote">{scene.note}</div>}
    {scene.analogy && <div class="analogy-line"><span class="al-mark">✎</span><span class="al-text" set:html={fmt(scene.analogy)} /></div>}
    </div>
  </div>
</section>

<style>
  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 20px; }
  @media (max-width: 820px) { .tiers { grid-template-columns: 1fr; } }
  .tier { background: var(--card); border: 1px solid var(--hair); border-top: 5px solid var(--c); border-radius: 14px; padding: 18px 20px; box-shadow: var(--shadow); display: flex; flex-direction: column;
          opacity: 0; transform: translateY(12px); }
  .tiers-scene.play .tier { animation: tierIn .5s cubic-bezier(.22,.61,.36,1) forwards; animation-delay: calc(var(--i) * 110ms + 80ms); }
  @keyframes tierIn { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .tier { opacity: 1; transform: none; } .tiers-scene.play .tier { animation: none; } }
  .tname { font-family: var(--ui-semi); font-size: clamp(18px,2.2vw,23px); color: var(--c); }
  .traits { list-style: none; margin: 12px 0; display: flex; flex-direction: column; gap: 6px; }
  .traits li { font-size: 13px; color: var(--inklite); font-weight: 600; padding-left: 16px; position: relative; }
  .traits li::before { content: "·"; position: absolute; left: 4px; color: var(--c); font-weight: 800; }
  .ex { background: var(--paper); border: 1px solid var(--hair); border-radius: 10px; padding: 11px 13px; flex: 1; }
  .ex .exlab { font-family: var(--ui); font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--brass); font-size: 11px; line-height: 1; }
  .ex p { font-size: 12.5px; color: var(--ink); line-height: 1.4; margin-top: 5px; }
  .tfoot { display: flex; align-items: baseline; justify-content: space-between; margin-top: 14px; gap: 10px; }
  .cr b { font-family: var(--ui-semi); font-size: clamp(20px,2.6vw,28px); color: var(--ink); }
  .cr span { font-size: 11px; color: var(--inklite); font-weight: 600; margin-left: 5px; }
  .dl { font-size: 13px; font-weight: 700; color: var(--brass); background: var(--brass-soft); padding: 3px 9px; border-radius: 7px; }
  .tnote { margin-top: 16px; font-size: 12px; color: var(--inklite); line-height: 1.5; max-width: 70ch; }
</style>

<script>
  function initTiers() {
    document.querySelectorAll<HTMLElement>('.tiers-scene').forEach((scene) => {
      if ((scene as any)._tInit) return;
      (scene as any)._tInit = true;
      let wasActive = scene.classList.contains('active');
      const play = () => { scene.classList.remove('play'); void scene.offsetWidth; scene.classList.add('play'); };
      if (wasActive) play();
      // Only replay on the false->true transition. Never react to play()'s OWN class
      // mutation — that self-trigger is an infinite microtask loop that pegs the page.
      new MutationObserver(() => {
        const isActive = scene.classList.contains('active');
        if (isActive && !wasActive) play();
        wasActive = isActive;
      }).observe(scene, { attributes: true, attributeFilter: ['class'] });
    });
  }
  initTiers();
  document.addEventListener('astro:page-load', initTiers);
</script>
