---
// Stage engine — the "boring" shared shell every demo runs through.
// Provides nav, fullscreen, overview/jump, speaker notes, day/night,
// customer/presenter mode, deep-links, panic-reset. Scenes go in the slot.
interface SceneMeta { title: string; notes?: string; }
interface Props { demoTitle: string; topic: string; scenes: SceneMeta[]; }
const { demoTitle, topic, scenes } = Astro.props;
---
<div class="stage">
  <div class="brandtag">
    <div class="logo">D</div>
    <div><b>{demoTitle}</b><small>{topic}</small></div>
  </div>

  <div class="hud">
    <button data-hud="grid" title="Overview / pick slides (O)">▦</button>
    <button data-hud="theme" title="Day / night (T)">◐</button>
    <button data-hud="notes" title="Speaker notes (S)">✎</button>
    <button data-hud="full" title="Fullscreen (F)">⛶</button>
    <button data-hud="help" title="Shortcuts (?)">?</button>
  </div>

  <slot />

  <div class="foot">
    <button class="navbtn" data-nav="prev" title="Previous (←)">‹</button>
    <div class="dots"></div>
    <div class="counter">01 / 01</div>
    <span class="setchip" hidden></span>
    <button class="navbtn" data-nav="next" title="Next (→ / space)">›</button>
  </div>

  <div class="notes" data-notes-drawer>
    <div class="nlab">speaker notes</div>
    <p data-notes-text></p>
    <div class="hint">Press <b>S</b> to hide.</div>
  </div>

  <div class="overview" data-overview>
    <div class="ov-top">
      <div class="kicker">bird's-eye · {demoTitle}</div>
      <button class="btn" data-ov="close">Close ✕</button>
    </div>
    <div class="ov-sub">Click a title to <b>jump</b>. Or tick a few and <b>Present selected</b> — rolls through only those.</div>
    <div class="ov-grid"></div>
    <div class="ov-bar">
      <div class="left"><b data-ov="count">none selected</b> · pick the slides this audience needs</div>
      <div class="btns">
        <button class="btn" data-ov="all">Present all</button>
        <button class="btn primary" data-ov="sel" disabled>▶ Present selected</button>
      </div>
    </div>
  </div>

  <div class="help" data-help>
    <div class="panel">
      <h3>Stage shortcuts</h3>
      <ul>
        <li><span>Next</span><span><kbd>→</kbd> <kbd>Space</kbd></span></li>
        <li><span>Back</span><span><kbd>←</kbd></span></li>
        <li><span>Overview / pick</span><span><kbd>O</kbd></span></li>
        <li><span>Jump to slide</span><span><kbd>1</kbd>…<kbd>9</kbd></span></li>
        <li><span>Fullscreen</span><span><kbd>F</kbd></span></li>
        <li><span>Speaker notes</span><span><kbd>S</kbd></span></li>
        <li><span>Day / night</span><span><kbd>T</kbd></span></li>
        <li><span>Panic reset</span><span><kbd>0</kbd></span></li>
        <li><span>Close</span><span><kbd>Esc</kbd></span></li>
      </ul>
    </div>
  </div>
</div>

<script type="application/json" data-stage-scenes set:html={JSON.stringify(scenes)} />

<style is:global>
  .stage { position: fixed; inset: 0; background-color: var(--paper);
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 46px 46px; overflow: hidden; }
  .screen { position: absolute; inset: 0; display: none; padding: clamp(28px,5vw,84px) clamp(28px,5vw,84px) 96px;
    align-items: center; justify-content: center; opacity: 0; transform: translateY(14px) scale(.992);
    transition: opacity var(--t), transform var(--t); overflow: auto; }
  .screen.active { display: flex; opacity: 1; transform: none; }
  .wrap { width: min(1160px, 100%); margin: auto; }
  @media (prefers-reduced-motion: reduce) { .screen { transition: none; } }
</style>

<style>
  .brandtag { position: fixed; top: 18px; left: 22px; z-index: 40; display: flex; align-items: center; gap: 10px; }
  .brandtag .logo { width: 32px; height: 32px; border-radius: 9px; background: var(--navy); color: var(--paper); display: grid; place-items: center; font-family: var(--ui-semi); font-weight: 800; font-size: 15px; }
  .brandtag b { font-family: var(--ui-semi); font-size: 13.5px; line-height: 1; }
  .brandtag small { display: block; font-family: var(--hand); color: var(--brass); font-size: 15px; line-height: 1; text-transform: capitalize; }
  .hud { position: fixed; top: 16px; right: 18px; display: flex; gap: 8px; z-index: 40; }
  .hud button, .navbtn { width: 42px; height: 42px; border-radius: 11px; border: 1px solid var(--hair); background: var(--card); color: var(--ink); cursor: pointer; font-size: 17px; display: grid; place-items: center; box-shadow: 0 8px 20px -14px rgba(0,0,0,.5); transition: all .18s; }
  .hud button:hover, .navbtn:hover { border-color: var(--navy); color: var(--navy); transform: translateY(-1px); }
  .foot { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: center; justify-content: center; gap: 16px; padding: 14px; }
  .navbtn { width: 46px; height: 46px; font-size: 20px; }
  .dots { display: flex; gap: 9px; }
  .dots span { width: 9px; height: 9px; border-radius: 50%; background: var(--hair); transition: all .25s; cursor: pointer; }
  .dots span.on { background: var(--brass); width: 26px; border-radius: 999px; }
  .counter { font-family: var(--hand); color: var(--brass); font-size: 20px; min-width: 64px; text-align: center; }
  .setchip { display: inline-flex; align-items: center; gap: 6px; background: var(--brass-soft); border: 1px solid var(--brass); color: var(--brass); font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 999px; }
  .setchip[hidden] { display: none; }
  .notes { position: fixed; left: 0; right: 0; bottom: -46vh; height: 42vh; z-index: 50; background: var(--card); border-top: 3px solid var(--navy); box-shadow: 0 -20px 50px -20px rgba(0,0,0,.4); padding: 22px 30px; transition: bottom .35s cubic-bezier(.22,.61,.36,1); overflow: auto; }
  .notes.open { bottom: 0; }
  .notes .nlab { font-family: var(--hand); color: var(--brass); font-size: 24px; margin-bottom: 8px; }
  .notes p { font-size: 16px; line-height: 1.55; max-width: 80ch; }
  .notes .hint { margin-top: 14px; font-size: 13px; color: var(--inklite); }
  .overview { position: fixed; inset: 0; z-index: 55; background: var(--paper);
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 46px 46px; display: none; flex-direction: column; padding: clamp(20px,3vw,40px); }
  .overview.open { display: flex; }
  .ov-top { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .ov-sub { font-size: 13.5px; color: var(--inklite); margin: 6px 0 18px; }
  .ov-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; overflow: auto; padding: 4px 2px 10px; flex: 1; }
  .ov-card { position: relative; background: var(--card); border: 1px solid var(--hair); border-radius: 14px; padding: 16px; box-shadow: 0 14px 30px -24px rgba(0,0,0,.5); transition: all .18s; min-height: 140px; display: flex; flex-direction: column; }
  .ov-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--navy); }
  .ov-card.sel { border-color: var(--brass); box-shadow: 0 0 0 2px var(--brass-soft), var(--shadow); }
  .ov-card .ov-num { font-family: var(--hand); color: var(--brass); font-size: 24px; line-height: 1; }
  .ov-card .ov-title { font-family: var(--ui-semi); font-size: 16px; margin: 3px 0 6px; cursor: pointer; }
  .ov-card .ov-note { font-size: 11.5px; color: var(--inklite); line-height: 1.4; flex: 1; }
  .ov-card .ov-jump { margin-top: 10px; font-size: 11px; font-weight: 800; letter-spacing: .5px; text-transform: uppercase; color: var(--navy); cursor: pointer; }
  .ov-card .ov-check { position: absolute; top: 12px; right: 12px; }
  .ov-card .ov-check input { width: 18px; height: 18px; accent-color: var(--brass); cursor: pointer; }
  .ov-bar { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 14px; flex-wrap: wrap; }
  .ov-bar .left { font-size: 13px; color: var(--inklite); font-weight: 600; }
  .ov-bar .left b { color: var(--brass); }
  .ov-bar .btns { display: flex; gap: 10px; }
  .btn { border: 1px solid var(--hair); background: var(--card); color: var(--ink); font-family: var(--ui); font-weight: 700; font-size: 13px; padding: 9px 16px; border-radius: 10px; cursor: pointer; transition: all .18s; }
  .btn:hover { border-color: var(--navy); color: var(--navy); }
  .btn.primary { background: var(--navy); color: var(--paper); border-color: var(--navy); }
  .btn.primary:disabled { opacity: .4; cursor: not-allowed; }
  .help { position: fixed; inset: 0; z-index: 60; background: rgba(27,22,12,.5); display: none; place-items: center; }
  .help.open { display: grid; }
  .help .panel { background: var(--card); border: 1px solid var(--hair); border-radius: 18px; padding: 28px 34px; box-shadow: var(--shadow); max-width: 440px; width: 90%; }
  .help h3 { font-family: var(--ui-semi); margin-bottom: 14px; color: var(--navy); }
  .help ul { list-style: none; }
  .help kbd { font-family: var(--ui); background: var(--paper); border: 1px solid var(--hair); border-bottom-width: 2px; border-radius: 6px; padding: 2px 8px; font-weight: 700; font-size: 12px; }
  .help li { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 1px dashed var(--hair); font-size: 14px; }
  .help li:last-child { border: 0; }
</style>

<script>
  function initStage() {
    const stage = document.querySelector('.stage') as HTMLElement | null;
    if (!stage) return;
    const screens = [...stage.querySelectorAll<HTMLElement>('.screen')];
    const N = screens.length;
    if (!N) return;
    const meta = JSON.parse(stage.querySelector('[data-stage-scenes]')?.textContent || '[]');
    const TITLES: string[] = meta.map((m: any, i: number) => m.title || `Slide ${i + 1}`);

    let order = [...Array(N).keys()];
    let pos = 0;
    const selected = new Set<number>();

    const dotsEl = stage.querySelector('.dots')!;
    const counter = stage.querySelector('.counter')!;
    const setchip = stage.querySelector('.setchip') as HTMLElement;
    const notesDrawer = stage.querySelector('[data-notes-drawer]')!;
    const notesText = stage.querySelector('[data-notes-text]')!;
    const overview = stage.querySelector('[data-overview]')!;
    const ovGrid = stage.querySelector('.ov-grid')!;
    const help = stage.querySelector('[data-help]')!;
    const root = document.documentElement;

    function buildDots() {
      dotsEl.innerHTML = '';
      order.forEach((abs, i) => {
        const s = document.createElement('span');
        s.className = i === pos ? 'on' : '';
        s.title = TITLES[abs];
        s.onclick = () => { pos = i; render(); };
        dotsEl.appendChild(s);
      });
    }
    function render() {
      const c = order[pos];
      screens.forEach((s, i) => s.classList.toggle('active', i === c));
      buildDots();
      counter.textContent = String(pos + 1).padStart(2, '0') + ' / ' + String(order.length).padStart(2, '0');
      notesText.textContent = meta[c]?.notes || '(no notes)';
      if (order.length < N) { setchip.hidden = false; setchip.textContent = '✓ custom set · ' + order.length; }
      else setchip.hidden = true;
      if (screens[c].id) history.replaceState(null, '', '#' + screens[c].id);
    }
    function go(i: number) { pos = Math.max(0, Math.min(order.length - 1, i)); render(); }
    function next() { if (pos < order.length - 1) go(pos + 1); }
    function prev() { if (pos > 0) go(pos - 1); }

    stage.querySelector('[data-nav="next"]')!.addEventListener('click', next);
    stage.querySelector('[data-nav="prev"]')!.addEventListener('click', prev);

    // overview / picker
    function updateOvBar() {
      (stage.querySelector('[data-ov="count"]') as HTMLElement).textContent = selected.size ? selected.size + ' selected' : 'none selected';
      (stage.querySelector('[data-ov="sel"]') as HTMLButtonElement).disabled = selected.size === 0;
    }
    function buildOverview() {
      ovGrid.innerHTML = '';
      for (let i = 0; i < N; i++) {
        const card = document.createElement('div');
        card.className = 'ov-card' + (selected.has(i) ? ' sel' : '');
        card.innerHTML = `<label class="ov-check"><input type="checkbox" ${selected.has(i) ? 'checked' : ''}></label>
          <div class="ov-num">${String(i + 1).padStart(2, '0')}</div>
          <div class="ov-title">${TITLES[i]}</div>
          <div class="ov-note">${(meta[i]?.notes || '').slice(0, 90)}</div>
          <div class="ov-jump">Jump here →</div>`;
        const jump = () => { order = [...Array(N).keys()]; pos = i; overview.classList.remove('open'); render(); };
        card.querySelector('.ov-title')!.addEventListener('click', jump);
        card.querySelector('.ov-jump')!.addEventListener('click', jump);
        card.querySelector('input')!.addEventListener('change', (e) => {
          const ck = (e.target as HTMLInputElement).checked;
          ck ? selected.add(i) : selected.delete(i);
          card.classList.toggle('sel', ck); updateOvBar();
        });
        ovGrid.appendChild(card);
      }
      updateOvBar();
    }
    stage.querySelector('[data-hud="grid"]')!.addEventListener('click', () => { buildOverview(); overview.classList.add('open'); });
    stage.querySelector('[data-ov="close"]')!.addEventListener('click', () => overview.classList.remove('open'));
    stage.querySelector('[data-ov="all"]')!.addEventListener('click', () => { order = [...Array(N).keys()]; pos = 0; overview.classList.remove('open'); render(); });
    stage.querySelector('[data-ov="sel"]')!.addEventListener('click', () => { if (selected.size) { order = [...selected].sort((a, b) => a - b); pos = 0; overview.classList.remove('open'); render(); } });

    // hud
    const toggleTheme = () => { const t = root.dataset.theme === 'day' ? 'night' : 'day'; root.dataset.theme = t; localStorage.setItem('demos-theme', t); };
    stage.querySelector('[data-hud="theme"]')!.addEventListener('click', toggleTheme);
    stage.querySelector('[data-hud="notes"]')!.addEventListener('click', () => notesDrawer.classList.toggle('open'));
    stage.querySelector('[data-hud="full"]')!.addEventListener('click', () => { document.fullscreenElement ? document.exitFullscreen?.() : document.documentElement.requestFullscreen?.(); });
    stage.querySelector('[data-hud="help"]')!.addEventListener('click', () => help.classList.toggle('open'));
    help.addEventListener('click', (e) => { if (e.target === help) help.classList.remove('open'); });

    // panic reset
    function reset() { order = [...Array(N).keys()]; pos = 0; selected.clear(); overview.classList.remove('open'); notesDrawer.classList.remove('open'); help.classList.remove('open'); render(); }

    addEventListener('keydown', (e) => {
      if ((overview as HTMLElement).classList.contains('open') && e.key === 'Escape') { overview.classList.remove('open'); return; }
      if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') { e.preventDefault(); next(); }
      else if (e.key === 'ArrowLeft' || e.key === 'PageUp') { e.preventDefault(); prev(); }
      else if (e.key === 'o' || e.key === 'O') (stage.querySelector('[data-hud="grid"]') as HTMLElement).click();
      else if (e.key === 'f' || e.key === 'F') (stage.querySelector('[data-hud="full"]') as HTMLElement).click();
      else if (e.key === 's' || e.key === 'S') notesDrawer.classList.toggle('open');
      else if (e.key === 't' || e.key === 'T') toggleTheme();
      else if (e.key === '?') help.classList.toggle('open');
      else if (e.key === '0') reset();
      else if (e.key === 'Escape') { help.classList.remove('open'); notesDrawer.classList.remove('open'); }
      else if (e.key >= '1' && e.key <= '9') { const n = parseInt(e.key) - 1; if (n < order.length) go(n); }
    });

    // deep-link on load
    const hash = location.hash.slice(1);
    if (hash) { const idx = screens.findIndex((s) => s.id === hash); if (idx >= 0) pos = order.indexOf(idx); }
    render();
  }
  initStage();
  document.addEventListener('astro:page-load', initStage);
</script>
