---
import '../styles/notebook.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Demos — A Guide to Cloud',
  description = 'Interactive demo decks for live customer sessions.',
  noindex = true,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="day">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#F4EFE3" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="author" content="Susanth Sutheesh (Sush)" />
  <link rel="icon" type="image/svg+xml"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2322385C'/%3E%3Ctext x='32' y='45' font-family='Segoe UI,sans-serif' font-size='32' font-weight='700' text-anchor='middle' fill='%23F4EFE3'%3ED%3C/text%3E%3C/svg%3E" />
  <!-- Pre-paint theme set (no flash). No external analytics — telemetry-free by design. -->
  <script is:inline>
    (() => {
      const p = new URLSearchParams(location.search).get('theme');
      const t = p || localStorage.getItem('demos-theme') || 'day';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
