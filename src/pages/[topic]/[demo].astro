---
import Base from '../../layouts/Base.astro';
import Stage from '../../components/stage/Stage.astro';
import Cover from '../../components/scenes/Cover.astro';
import CostMeter from '../../components/scenes/CostMeter.astro';
import Compare from '../../components/scenes/Compare.astro';
import TwoPart from '../../components/scenes/TwoPart.astro';
import Concept from '../../components/scenes/Concept.astro';
import CreditBuilder from '../../components/scenes/CreditBuilder.astro';
import Tiers from '../../components/scenes/Tiers.astro';
import Closing from '../../components/scenes/Closing.astro';
import WhyUsage from '../../components/scenes/WhyUsage.astro';
import Philosophies from '../../components/scenes/Philosophies.astro';
import Differentiators from '../../components/scenes/Differentiators.astro';
import Statement from '../../components/scenes/Statement.astro';
import Estimator from '../../components/scenes/Estimator.astro';
import PricingExamples from '../../components/scenes/PricingExamples.astro';
import CoworkChat from '../../components/scenes/CoworkChat.astro';
import BuyOptions from '../../components/scenes/BuyOptions.astro';
import PlanTable from '../../components/scenes/PlanTable.astro';
import AgentLoop from '../../components/scenes/AgentLoop.astro';
import ValueCurve from '../../components/scenes/ValueCurve.astro';
import SkillsGrid from '../../components/scenes/SkillsGrid.astro';
import Architecture from '../../components/scenes/Architecture.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const demos = await getCollection('demos', (d) => d.data.visibility !== 'private');
  return demos.map((demo) => {
    const [topic, slug] = demo.id.split('/');
    return { params: { topic, demo: slug }, props: { demo } };
  });
}

const { demo } = Astro.props;
const d = demo.data;

// derive a short title per scene for the overview/dots
const sceneTitle = (s: any): string => {
  if (s.type === 'cover') return 'Cover';
  if (s.type === 'costMeter') return 'Cost meter';
  if (s.type === 'compare') return 'Compare';
  if (s.type === 'twoPart') return 'Two parts';
  if (s.type === 'concept') return s.stat ? 'The credit' : 'Concept';
  if (s.type === 'creditBuilder') return 'Four inputs';
  if (s.type === 'tiers') return 'Task sizes';
  if (s.type === 'whyUsage') return 'Why usage-based';
  if (s.type === 'philosophies') return 'Two approaches';
  if (s.type === 'differentiators') return "What's different";
  if (s.type === 'statement') return s.text ? s.text.replace(/[*_]/g, '').slice(0, 22) : 'Statement';
  if (s.type === 'estimator') return 'Plan your spend';
  if (s.type === 'pricingExamples') return 'Pricing examples';
  if (s.type === 'coworkChat') return 'The exact number';
  if (s.type === 'buyOptions') return 'Two ways to buy';
  if (s.type === 'planTable') return 'Which plan';
  if (s.type === 'agentLoop') return 'How it works';
  if (s.type === 'valueCurve') return 'Where it fits';
  if (s.type === 'skillsGrid') return 'Skills & plugins';
  if (s.type === 'architecture') return 'How it\'s wired';
  if (s.type === 'closing') return 'Wrap';
  return s.type;
};
const sceneMeta = d.scenes.map((s: any) => ({ title: sceneTitle(s), notes: s.notes }));
const noindex = d.visibility !== 'indexed';
---
<Base title={`${d.title} — Demos · A Guide to Cloud`} description={d.blurb} noindex={noindex}>
  <Stage demoTitle={d.title} topic={d.topic} scenes={sceneMeta}>
    {d.scenes.map((scene: any, i: number) => {
      if (scene.type === 'cover') return <Cover scene={scene} index={i} />;
      if (scene.type === 'costMeter') return <CostMeter scene={scene} index={i} />;
      if (scene.type === 'compare') return <Compare scene={scene} index={i} />;
      if (scene.type === 'twoPart') return <TwoPart scene={scene} index={i} />;
      if (scene.type === 'concept') return <Concept scene={scene} index={i} />;
      if (scene.type === 'creditBuilder') return <CreditBuilder scene={scene} index={i} />;
      if (scene.type === 'tiers') return <Tiers scene={scene} index={i} />;
      if (scene.type === 'whyUsage') return <WhyUsage scene={scene} index={i} />;
      if (scene.type === 'philosophies') return <Philosophies scene={scene} index={i} />;
      if (scene.type === 'differentiators') return <Differentiators scene={scene} index={i} />;
      if (scene.type === 'statement') return <Statement scene={scene} index={i} />;
      if (scene.type === 'estimator') return <Estimator scene={scene} index={i} />;
      if (scene.type === 'pricingExamples') return <PricingExamples scene={scene} index={i} />;
      if (scene.type === 'coworkChat') return <CoworkChat scene={scene} index={i} />;
      if (scene.type === 'buyOptions') return <BuyOptions scene={scene} index={i} />;
      if (scene.type === 'planTable') return <PlanTable scene={scene} index={i} />;
      if (scene.type === 'agentLoop') return <AgentLoop scene={scene} index={i} />;
      if (scene.type === 'valueCurve') return <ValueCurve scene={scene} index={i} />;
      if (scene.type === 'skillsGrid') return <SkillsGrid scene={scene} index={i} />;
      if (scene.type === 'architecture') return <Architecture scene={scene} index={i} />;
      if (scene.type === 'closing') return <Closing scene={scene} index={i} />;
      return null;
    })}
  </Stage>
</Base>
