---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const demos = await getCollection('demos', (d) => d.data.visibility !== 'private');
const byTopic = new Map<string, typeof demos>();
for (const d of demos.sort((a, b) => a.data.order - b.data.order)) {
  const arr = byTopic.get(d.data.topic) ?? [];
  arr.push(d); byTopic.set(d.data.topic, arr);
}
const topics = [...byTopic.keys()];
---
<Base title="Demos — A Guide to Cloud" description="Interactive demo decks for live customer sessions." noindex={true}>
  <main class="catalog">
    <header class="cat-head">
      <div class="eyebrow">A Guide to Cloud</div>
      <h1 class="scene-h1">Interactive <span class="uline">demos</span></h1>
      <p class="lead">Premium, launchable demo decks for live customer sessions — explainers, annotated tours and scenario replays. Pick one and present.</p>
    </header>

    {topics.map((topic) => (
      <section class="topic">
        <h2 class="topic-h"><span class="kicker">{topic}</span></h2>
        <div class="cards">
          {byTopic.get(topic)!.map((d) => (
            <a class="card" href={`/${d.id}`}>
              <div class="card-num">{String(d.data.order).padStart(2, '0')}</div>
              <h3>{d.data.title}</h3>
              <p>{d.data.blurb}</p>
              <div class="card-foot">
                {d.data.durationMin && <span class="dur">≈{d.data.durationMin} min</span>}
                <span class="personas">{d.data.personas.join(' · ')}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <footer class="cat-foot">
      Personal demo companion by Sush. Not official Microsoft documentation — product claims cite public Microsoft sources.
    </footer>
  </main>
</Base>

<style>
  .catalog { min-height: 100vh; max-width: 1100px; margin: 0 auto; padding: clamp(40px,7vw,90px) clamp(22px,5vw,40px) 80px;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 46px 46px; }
  .cat-head { margin-bottom: 40px; }
  .cat-head .lead { margin-top: 10px; }
  .topic { margin-bottom: 40px; }
  .topic-h { margin-bottom: 16px; text-transform: capitalize; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .card { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--hair); border-radius: 16px;
    padding: 20px; text-decoration: none; color: var(--ink); box-shadow: 0 14px 30px -24px rgba(0,0,0,.5); transition: transform .18s, box-shadow .18s, border-color .18s; position: relative; }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--navy); }
  .card-num { font-family: var(--hand); color: var(--brass); font-size: 26px; line-height: 1; }
  .card h3 { font-family: var(--ui-semi); font-size: 19px; margin: 4px 0 6px; }
  .card p { font-size: 13.5px; color: var(--inklite); line-height: 1.45; flex: 1; }
  .card-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; font-size: 11.5px; font-weight: 700; }
  .card-foot .dur { color: var(--navy); background: var(--navy-soft); padding: 3px 8px; border-radius: 6px; }
  .card-foot .personas { color: var(--inklite); text-transform: capitalize; }
  .cat-foot { margin-top: 50px; padding-top: 20px; border-top: 1px dashed var(--hair); font-size: 12px; color: var(--inklite); line-height: 1.5; }
</style>
