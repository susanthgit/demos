---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { TOPICS, PLANNED, MODALITY_LABELS } from '../data/catalog';

// ---- merge BUILT demos (collection, ready) + PLANNED teasers (soon) ----
const built = await getCollection('demos', (d) => d.data.visibility !== 'private');
type Card = {
  topic: string; slug: string; title: string; blurb: string;
  modality: string; durationMin?: number; note?: string;
  status: 'ready' | 'soon'; href?: string;
};

const cards: Card[] = [];
const seen = new Set<string>();
for (const d of built) {
  const [topic, slug] = d.id.split('/');
  seen.add(`${topic}/${slug}`);
  cards.push({
    topic, slug, title: d.data.title, blurb: d.data.blurb,
    modality: d.data.modality, durationMin: d.data.durationMin,
    note: d.data.note, status: 'ready', href: `/${d.id}`,
  });
}
for (const p of PLANNED) {
  if (seen.has(`${p.topic}/${p.slug}`)) continue;
  cards.push({ ...p, status: 'soon' });
}

const topicOrder = new Map(TOPICS.map((t) => [t.id, t.order]));
cards.sort((a, b) => {
  if (a.status !== b.status) return a.status === 'ready' ? -1 : 1;
  return (topicOrder.get(a.topic) ?? 99) - (topicOrder.get(b.topic) ?? 99);
});

const topicMap = new Map(TOPICS.map((t) => [t.id, t]));
const topicLabel = (id: string) => topicMap.get(id)?.label ?? id;
const featured = cards.find((c) => c.status === 'ready');
const readyCount = cards.filter((c) => c.status === 'ready').length;
const soonCards = cards.filter((c) => c.status === 'soon');
// the index grid shows ready demos + soon ones (excludes featured to avoid dupe)
const gridCards = cards.filter((c) => c !== featured);
// topics that actually have cards
const usedTopics = TOPICS.filter((t) => cards.some((c) => c.topic === t.id));
---
<Base title="Demos — A Guide to Cloud" description="Interactive demo decks for live customer sessions — pick one and present." noindex={true}>
  <main class="home">
    <div class="top">
      <div class="brand"><span class="logo">D</span><b>Demos</b><span class="by">· A Guide to Cloud</span></div>
      <button id="theme" class="tbtn" title="Day / night">◐</button>
    </div>

    <!-- hero spread -->
    <div class="spread">
      <div class="left">
        <div class="eye">Interactive · launch live · works offline</div>
        <h1>The demos I use <span class="u">instead of</span> PowerPoint.</h1>
        <div class="kick">built for live customer conversations</div>
        <p>A curated shelf of interactive stories — pick one, go fullscreen, and let the room follow along. No slides, no failed live demos.</p>
        <div class="signoff">— Sush</div>
      </div>
      {featured && (
        <a class="pass" href={featured.href}>
          <div class="strip"><span>FEATURED · today's open page</span><span class="seal">ready ✦</span></div>
          <div class="body">
            <span class="topic">{topicLabel(featured.topic)}</span>
            <h3>{featured.title}</h3>
            <div class="bl">{featured.blurb}</div>
            <div class="perf"></div>
            <div class="meta">
              <span class="mod">{MODALITY_LABELS[featured.modality]}</span>
              {featured.durationMin && <span>≈{featured.durationMin} min</span>}
            </div>
            <span class="launch">Launch demo →</span>
            {featured.note && <div class="passnote">{featured.note}</div>}
          </div>
        </a>
      )}
    </div>

    <!-- search -->
    <div class="find">
      <div class="sw"><span class="i">⌕</span><input id="q" type="search" placeholder="Search the shelf…" autocomplete="off" aria-label="Search demos" /></div>
    </div>

    <!-- topic tabs -->
    <div class="tabs" id="tabs">
      <button class="tab on" data-tp="all">All</button>
      {usedTopics.map((t) => <button class="tab" data-tp={t.id}>{t.label}</button>)}
    </div>

    <!-- index cards -->
    <div class="grid" id="grid">
      {gridCards.map((c, i) => {
        const inner = (
          <>
            <div class="ct">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class={`st ${c.status}`}>{c.status}</span>
            </div>
            <h4>{c.title}</h4>
            <div class="bl">{c.blurb}</div>
            {c.note && <div class="marg">“{c.note}”</div>}
            <div class="cf">
              <span class="topictag">{topicLabel(c.topic)}</span>
              <span class="mod">{MODALITY_LABELS[c.modality]}</span>
              {c.durationMin && <span class="dur">≈{c.durationMin}m</span>}
            </div>
          </>
        );
        return c.status === 'ready' ? (
          <a class="icard ready" href={c.href} data-topic={c.topic}
             data-text={`${c.title} ${c.blurb} ${topicLabel(c.topic)}`.toLowerCase()}>{inner}</a>
        ) : (
          <div class="icard soon" data-topic={c.topic}
               data-text={`${c.title} ${c.blurb} ${topicLabel(c.topic)}`.toLowerCase()}>{inner}</div>
        );
      })}
    </div>
    <div class="empty" id="empty" hidden>Nothing on the shelf matches — <button id="emptyClear" class="linkbtn">clear</button>.</div>

    <!-- roadmap shelf -->
    {soonCards.length > 0 && (
      <div class="shelf">
        <div class="sh"><span class="h">in the notebook next</span><span class="s">being shaped into live-ready demos</span></div>
        <div class="tiles">
          {soonCards.map((c) => (
            <div class="tile">
              <div class="mk">{topicLabel(c.topic).split(' ').map((w) => w[0]).join('').slice(0, 2)}</div>
              <div class="ti">{c.title}</div>
              <div class="pl">{topicLabel(c.topic)} · {MODALITY_LABELS[c.modality]}{c.durationMin ? ` · ≈${c.durationMin}m` : ''}</div>
            </div>
          ))}
        </div>
      </div>
    )}

    <footer class="home-foot">
      Personal demo companion by Sush. Not official Microsoft documentation — product claims cite public Microsoft sources. No customer or tenant data.
    </footer>
  </main>
</Base>

<style>
  .home { max-width: 1120px; margin: 0 auto; padding: 0 clamp(22px,5vw,44px) 80px; }
  .top { display: flex; justify-content: space-between; align-items: center; padding: 22px 0 0; }
  .brand { display: flex; align-items: center; gap: 9px; }
  .brand .logo { width: 30px; height: 30px; border-radius: 8px; background: var(--navy); color: var(--paper); display: grid; place-items: center; font-family: var(--ui-semi); font-weight: 800; font-size: 14px; }
  .brand b { font-family: var(--ui-semi); font-size: 16px; }
  .brand .by { font-family: var(--hand); color: var(--brass); font-size: 16px; }
  .tbtn { width: 38px; height: 38px; border-radius: 10px; border: 1px solid var(--hair); background: var(--card); cursor: pointer; font-size: 15px; color: var(--ink); }
  .tbtn:hover { border-color: var(--navy); color: var(--navy); }

  .spread { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(24px,4vw,56px); align-items: center; padding: clamp(36px,6vw,66px) 0 30px; }
  @media (max-width: 880px) { .spread { grid-template-columns: 1fr; gap: 28px; } }
  .eye { font-weight: 700; text-transform: uppercase; letter-spacing: 3.4px; color: var(--navy); font-size: 12px; }
  .left h1 { font-family: var(--ui-semi); font-weight: 700; font-size: clamp(34px,5.2vw,60px); line-height: 1.02; letter-spacing: -1px; margin: 10px 0 0; }
  .left h1 .u { box-shadow: inset 0 -.4em 0 var(--brass-soft); }
  .kick { font-family: var(--hand); color: var(--brass); font-size: clamp(20px,2.4vw,28px); margin-top: 14px; }
  .left p { font-size: clamp(16px,1.8vw,20px); color: var(--inklite); line-height: 1.5; max-width: 44ch; margin-top: 12px; }
  .signoff { font-family: var(--hand); color: var(--brass); font-size: 22px; margin-top: 16px; }

  .pass { display: block; text-decoration: none; color: var(--ink); background: var(--card); border: 1px solid var(--hair); border-radius: 18px; box-shadow: var(--shadow); overflow: hidden; position: relative; transition: transform .18s; }
  .pass:hover { transform: translateY(-3px); }
  .pass .strip { background: var(--navy); color: var(--paper); padding: 10px 20px; display: flex; justify-content: space-between; align-items: center; font-size: 12px; font-weight: 700; letter-spacing: .5px; }
  .pass .strip .seal { font-family: var(--hand); color: #fff; font-size: 17px; }
  .pass .body { padding: 22px 24px; }
  .pass .topic { font-size: 10.5px; font-weight: 800; letter-spacing: .6px; text-transform: uppercase; color: var(--navy); background: var(--navy-soft); padding: 3px 9px; border-radius: 6px; }
  .pass h3 { font-family: var(--ui-semi); font-size: clamp(22px,2.8vw,30px); margin: 12px 0 6px; }
  .pass .bl { font-size: 14.5px; color: var(--inklite); line-height: 1.5; }
  .pass .perf { border-top: 2px dashed var(--hair); margin: 18px -24px; position: relative; }
  .pass .perf::before, .pass .perf::after { content: ""; position: absolute; top: -9px; width: 18px; height: 18px; border-radius: 50%; background: var(--paper); border: 1px solid var(--hair); }
  .pass .perf::before { left: -9px; } .pass .perf::after { right: -9px; }
  .pass .meta { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
  .pass .meta span { font-size: 11.5px; font-weight: 700; padding: 4px 10px; border-radius: 7px; background: var(--paper); border: 1px solid var(--hair); color: var(--inklite); }
  .pass .meta .mod { color: var(--brass); background: var(--brass-soft); border-color: transparent; }
  .launch { display: inline-flex; align-items: center; gap: 10px; background: var(--brass); color: #fff; border-radius: 12px; padding: 12px 22px; font-family: var(--ui-semi); font-weight: 700; font-size: 15px; }
  .pass:hover .launch { filter: brightness(1.06); }
  .pass .passnote { position: absolute; right: 18px; bottom: 14px; font-family: var(--hand); color: var(--brass); font-size: 16px; transform: rotate(-4deg); opacity: .8; }

  .find { margin: 14px 0 6px; }
  .find .sw { position: relative; max-width: 460px; }
  .find .sw .i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--inklite); font-size: 18px; }
  #q { width: 100%; padding: 12px 16px 12px 42px; border: 1px solid var(--hair); border-radius: 12px; background: var(--card); color: var(--ink); font-family: var(--ui); font-size: 15px; outline: none; }
  #q:focus { border-color: var(--navy); box-shadow: 0 0 0 3px var(--navy-soft); }

  .tabs { display: flex; gap: 4px; flex-wrap: wrap; margin: 22px 0 4px; border-bottom: 1px solid var(--hair); }
  .tab { border: 0; background: transparent; color: var(--inklite); font-family: var(--ui-semi); font-weight: 700; font-size: 14px; padding: 11px 16px; cursor: pointer; position: relative; }
  .tab:hover { color: var(--navy); }
  .tab.on { color: var(--navy); }
  .tab.on::after { content: ""; position: absolute; left: 12px; right: 12px; bottom: -1px; height: 3px; background: var(--brass); border-radius: 3px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 20px; }
  .icard { background: var(--card); border: 1px solid var(--hair); border-radius: 14px; padding: 18px; position: relative; box-shadow: 0 14px 30px -24px rgba(0,0,0,.5); transition: transform .18s, box-shadow .18s, border-color .18s; display: flex; flex-direction: column; text-decoration: none; color: var(--ink); }
  .icard.ready:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--navy); }
  .icard .ct { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
  .icard .num { font-family: var(--hand); color: var(--brass); font-size: 24px; line-height: 1; }
  .icard .st { font-family: var(--hand); font-size: 15px; text-transform: capitalize; }
  .icard .st.ready { color: var(--green); } .icard .st.soon { color: var(--brass); }
  .icard h4 { font-family: var(--ui-semi); font-size: 18px; margin: 0 0 5px; }
  .icard .bl { font-size: 12.5px; color: var(--inklite); line-height: 1.45; flex: 1; }
  .icard .marg { font-family: var(--hand); color: var(--brass); font-size: 15px; margin-top: 10px; opacity: .92; }
  .icard .cf { display: flex; gap: 8px; align-items: center; margin-top: 12px; font-size: 11px; font-weight: 700; flex-wrap: wrap; }
  .icard .cf .topictag { color: var(--navy); background: var(--navy-soft); padding: 3px 8px; border-radius: 6px; }
  .icard .cf .mod { color: var(--brass); background: var(--brass-soft); padding: 3px 8px; border-radius: 6px; }
  .icard .cf .dur { color: var(--inklite); }
  .icard.soon { opacity: .66; }
  .icard.hide { display: none; }

  .empty { margin-top: 36px; text-align: center; color: var(--inklite); font-size: 14px; }
  .linkbtn { border: 0; background: none; color: var(--brass); font-family: var(--ui); font-weight: 700; font-size: 14px; cursor: pointer; text-decoration: underline; }

  .shelf { margin-top: 46px; padding-top: 24px; border-top: 2px solid var(--ink); }
  .shelf .sh { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .shelf .sh .h { font-family: var(--hand); color: var(--brass); font-size: 26px; }
  .shelf .sh .s { font-size: 13px; color: var(--inklite); }
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; margin-top: 16px; }
  .tile { border: 1px dashed var(--hair); border-radius: 12px; padding: 14px; opacity: .85; }
  .tile .mk { font-family: var(--hand); color: var(--brass); font-size: 20px; line-height: 1; }
  .tile .ti { font-family: var(--ui-semi); font-size: 14px; color: var(--inklite); margin-top: 4px; }
  .tile .pl { font-size: 11px; color: var(--inklite); margin-top: 6px; font-weight: 600; }

  .home-foot { margin-top: 46px; padding-top: 18px; border-top: 1px dashed var(--hair); font-size: 12px; color: var(--inklite); line-height: 1.5; }
</style>

<script>
  function initHome() {
    const grid = document.getElementById('grid');
    if (!grid) return;
    const cards = [...grid.querySelectorAll<HTMLElement>('.icard')];
    const q = document.getElementById('q') as HTMLInputElement;
    const empty = document.getElementById('empty') as HTMLElement;
    let topic = 'all', text = '';

    function apply() {
      let shown = 0;
      for (const c of cards) {
        const okT = topic === 'all' || c.dataset.topic === topic;
        const okQ = !text || (c.dataset.text || '').includes(text);
        const show = okT && okQ;
        c.classList.toggle('hide', !show);
        if (show) shown++;
      }
      empty.hidden = shown !== 0;
    }

    document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach((x) => x.classList.remove('on'));
        tab.classList.add('on');
        topic = tab.dataset.tp!;
        apply();
      });
    });
    q.addEventListener('input', () => { text = q.value.trim().toLowerCase(); apply(); });
    document.getElementById('emptyClear')?.addEventListener('click', () => {
      text = ''; q.value = ''; topic = 'all';
      document.querySelectorAll('.tab').forEach((x, i) => x.classList.toggle('on', i === 0));
      apply();
    });

    const root = document.documentElement;
    document.getElementById('theme')?.addEventListener('click', () => {
      const t = root.dataset.theme === 'day' ? 'night' : 'day';
      root.dataset.theme = t; localStorage.setItem('demos-theme', t);
    });

    apply();
  }
  initHome();
  document.addEventListener('astro:page-load', initHome);
</script>
